# ==========================================
# Telegram Bot Configuration
# ==========================================
BOT_TOKEN=your_telegram_bot_token
ADMIN_GROUP_ID=your_admin_group_id
MANAGER_IDS=comma_separated_telegram_user_ids
ORDER_TOPIC_ID=your_order_topic_id
TICKET_TOPIC_ID=your_ticket_topic_id
PAYMENT_TOPIC_ID=your_payment_topic_id

# Application routing and versioning
MINI_APP_URL=https://nitrobot.duckdns.org
DOMAIN_NAME=nitrobot.duckdns.org
APP_VERSION=2026-07-06-producers-convert-v5
ENVIRONMENT=production
APP_TIMEZONE=Asia/Tehran

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql+asyncpg://nitro_user:secure_password_here@db:5432/nitrodb
POSTGRES_USER=nitro_user
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=nitrodb

# ==========================================
# Object Storage Configuration (MinIO / S3)
# ==========================================
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=admin_access_key
S3_SECRET_KEY=super_secure_secret_key_here
S3_BUCKET=nitro-bot

# ==========================================
# Internal API Security & Authentication
# ==========================================
SELENIUM_SECRET_KEY=generate_a_long_random_internal_token
SKIP_TELEGRAM_AUTH=false
REDIS_URL=redis://redis:6379/0

# Payment destinations are served only by the authenticated backend API.
PAYMENT_CARD_NUMBER=your_card_number
PAYMENT_CARD_HOLDER=your_card_holder_name
PAYMENT_BTC_ADDRESS=your_bitcoin_wallet_address
PAYMENT_USDT_TRC20_ADDRESS=your_usdt_trc20_wallet_address

# ==========================================
# Kontor DMB Automation Worker
# ==========================================
DMB_USERNAME=your_dmb_username
DMB_PASSWORD=your_dmb_password
POLL_INTERVAL=30
DRY_RUN=false

# ==========================================
# Exchange Rates & APIs
# ==========================================
USDT_RATE_URL=https://api.nobitex.ir/market/stats?srcCurrency=usdt&dstCurrency=rls
USDT_TOMAN_FALLBACK=0

# ==========================================
# Frontend Build Variables
# ==========================================
VITE_API_URL=https://nitrobot.duckdns.org
VITE_BOT_USERNAME=NitroBot
